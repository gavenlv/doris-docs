# ========================================
# Doris Local Development Environment
# ========================================

# Doris Version
DORIS_VERSION=3.1.4
FDB_VERSION=7.1.37

# Resource Configuration (Minimal for Local)
FE_MEMORY_LIMIT=2g
BE_MEMORY_LIMIT=4g
FDB_MEMORY_LIMIT=1g

# FE Configuration
FE_HTTP_PORT=8030
FE_QUERY_PORT=9030
FE_EDIT_LOG_PORT=9010

# BE Configuration  
BE_HEARTBEAT_PORT=9050
BE_BRPC_PORT=8060

# FDB Configuration
FDB_CLUSTER_PORT=4500

# Monitoring (Optional)
ENABLE_MONITORING=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Network
NETWORK_NAME=doris-local
