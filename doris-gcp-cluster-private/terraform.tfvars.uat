# UAT Environment - Compute Storage Separation Configuration
# Project: doris-uat-project

project_id = "doris-uat-project"
environment = "uat"
cluster_name = "doris-separation"

region = "us-east1"
zone = "us-east1-b"

subnet_cidr = "10.2.0.0/16"
allowed_source_ranges = ["10.0.0.0/8", "192.168.0.0/16"]

# FE Configuration - UAT: 3FE for HA with FoundationDB
fe_count = 3
fe_machine_type = "e2-standard-4"
fe_disk_size = 200
fe_disk_type = "pd-ssd"
fe_preemptible = false

# FoundationDB Configuration - UAT: 5 nodes for HA
fdb_count = 5
fdb_machine_type = "e2-standard-8"
fdb_disk_size = 200

# BE Configuration - UAT: 4BE initial
be_count = 4
be_machine_type = "e2-standard-8"
be_preemptible = false

# ============================================================
# Compute Storage Separation Configuration
# ============================================================

# GCS Bucket for Cold Storage
gcs_bucket_name = "doris-uat-separation-storage"

# Hot Storage (SSD) - Local storage for hot data
hot_storage_type = "pd-ssd"
hot_storage_size = 600

# Cold Storage Retention
cold_storage_retention_days = 30

# ============================================================
# Auto Scaling Configuration
# ============================================================

be_min_count = 4
be_max_count = 10
autoscaling_cpu_target = 60
autoscaling_scale_up_cooldown = 300
autoscaling_scale_down_cooldown = 300

# ============================================================
# SSH Configuration
# ============================================================

ssh_user = "ubuntu"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# ============================================================
# Image Configuration
# ============================================================

image_family = "ubuntu-2204-lts"
