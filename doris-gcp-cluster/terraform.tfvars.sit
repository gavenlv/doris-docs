# SIT Environment Configuration
# Project: doris-sit-project

project_id = "doris-sit-project"
environment = "sit"
cluster_name = "doris"

region = "us-central1"
zone = "us-central1-a"

subnet_cidr = "10.1.0.0/16"
allowed_source_ranges = ["10.0.0.0/8", "192.168.0.0/16"]

# FE Configuration - SIT: 2FE for HA
fe_count = 2
fe_machine_type = "e2-medium"
fe_disk_size = 50
fe_disk_type = "pd-balanced"
fe_preemptible = false

# BE Configuration - SIT: 3BE
be_count = 3
be_machine_type = "e2-standard-4"
be_disk_size = 200
be_disk_type = "pd-ssd"
be_preemptible = false

# Storage Configuration
enable_compute_storage_separation = true
gcs_bucket_name = "doris-sit-storage"
hot_storage_type = "pd-ssd"
hot_storage_size = 400
cold_storage_retention_days = 30

# Auto Scaling Configuration
enable_autoscaling = true
be_min_count = 3
be_max_count = 8
autoscaling_cpu_target = 65
autoscaling_scale_up_cooldown = 300
autoscaling_scale_down_cooldown = 300

# Load Balancer Configuration
enable_load_balancer = true

# SSH Configuration
ssh_user = "ubuntu"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Image Configuration
image_family = "ubuntu-2204-lts"
