# 2FE+2BE Configuration
# Balanced resource usage for testing

project_id = "your-project-id"
region      = "us-central1"
zone        = "us-central1-a"

cluster_name = "doris"
environment  = "staging"

subnet_cidr = "10.0.0.0/16"
allowed_source_ranges = ["0.0.0.0/0"]

fe_count = 2
be_count = 2

fe_machine_type = "e2-medium"
be_machine_type = "e2-standard-2"

fe_disk_size = 50
be_disk_size = 100

fe_disk_type = "pd-balanced"
be_disk_type = "pd-ssd"

image_family = "ubuntu-2204-lts"

ssh_user = "ubuntu"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

fe_preemptible = true
be_preemptible = true

fe_servers = "fe1:10.0.0.11:9010,fe2:10.0.0.12:9011"
