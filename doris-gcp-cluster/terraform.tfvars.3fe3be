# 3FE+3BE Production Configuration
# High availability production setup

project_id = "your-project-id"
region      = "us-central1"
zone        = "us-central1-a"

cluster_name = "doris"
environment  = "prod"

subnet_cidr = "10.0.0.0/16"
allowed_source_ranges = ["0.0.0.0/0"]

fe_count = 3
be_count = 3

fe_machine_type = "e2-standard-2"
be_machine_type = "e2-standard-4"

fe_disk_size = 100
be_disk_size = 200

fe_disk_type = "pd-ssd"
be_disk_type = "pd-ssd"

image_family = "ubuntu-2204-lts"

ssh_user = "ubuntu"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

fe_preemptible = false
be_preemptible = false

fe_servers = "fe1:10.0.0.11:9010,fe2:10.0.0.12:9011,fe3:10.0.0.13:9012"
