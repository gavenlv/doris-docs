DORIS_REGISTRY=zlsmshoqvwt6q1.xuanyuan.run
DORIS_VERSION=4.0.2
DORIS_CLUSTER_NAME=doris_cluster

DORIS_FE_MEMORY=1G
DORIS_BE_MEMORY=2G
DORIS_FE_CPUS=1
DORIS_BE_CPUS=2

DORIS_FE_RESERVATION_CPUS=1
DORIS_FE_RESERVATION_MEMORY=1G
DORIS_BE_RESERVATION_CPUS=2
DORIS_BE_RESERVATION_MEMORY=2G

DORIS_HEALTHCHECK_INTERVAL=10s
DORIS_HEALTHCHECK_TIMEOUT=5s
DORIS_HEALTHCHECK_RETRIES=5
DORIS_HEALTHCHECK_START_PERIOD=60s

DORIS_NETWORK_SUBNET=172.20.0.0/16
DORIS_FE1_IP=172.20.0.11
DORIS_FE2_IP=172.20.0.12
DORIS_FE3_IP=172.20.0.13
DORIS_BE1_IP=172.20.0.21
DORIS_BE2_IP=172.20.0.22
DORIS_BE3_IP=172.20.0.23
DORIS_FE_SERVERS=fe1:172.20.0.11:9010,fe2:172.20.0.12:9011,fe3:172.20.0.13:9012
